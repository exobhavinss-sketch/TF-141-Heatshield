# Target Flask REST API Base URL (Optional local python analytics service)
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Public Configuration
# Retrieve these from: Supabase Dashboard -> Project Settings -> API
# Note: VITE_* variables are exposed to the browser.
# NEVER place service_role keys, database passwords, or SMTP secrets here!
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy Supabase Anon Key compatibility (optional fallback if using legacy project)
# VITE_SUPABASE_ANON_KEY=
