# Public frontend configuration. VITE_* values are compiled into browser assets.
# Use only the current Supabase project's URL and publishable/anon key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy public-key fallback. Prefer VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=

# Optional external analytics API; leave blank when it is not deployed.
# VITE_API_BASE_URL=

# Optional canonical origin for authentication links. When blank, the app uses
# the current browser origin (including the Netlify production or preview host).
# VITE_AUTH_REDIRECT_URL=https://<your-site>.netlify.app
# VITE_SITE_URL=https://<your-site>.netlify.app

# Never put SUPABASE_SERVICE_ROLE_KEY, database passwords, SMTP credentials,
# or other server-only secrets in this file or in any VITE_ variable.
