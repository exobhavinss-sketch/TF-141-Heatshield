dist/
dist-ssr/
build/
.next/
out/
coverage/
.cache/
.parcel-cache/
.vite/
.eslintcache
.stylelintcache

# ----------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL SECURITY)
# ----------------------------------------------------------------------------
# Ignore all local environment and secret configuration files
.env
.env.*
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Explicitly track the public sanitized environment template
!.env.example

